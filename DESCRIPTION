Package: glmmpa
Title: Power Approximation for Generalized Linear Mixed Models
Version: 1.0.0
Authors@R: 
    c(person("Carlie", "Prinster", email = "prinstercarlie@gmail.com", 
     role = c("aut", "cre"), comment = c(ORCID = "0009-0009-6392-9750")),
      person("John", "Stevens", role = c("aut"), 
           comment = c(ORCID = "0000-0002-2908-7918"))
